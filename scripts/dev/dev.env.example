# Copy selected values into data/run/mysql.env or export them in your shell.
# Do not commit real passwords.

# Backend
PORT=8194
BACKEND_MODE=mysql
LINEAGE_SECURITY_PERMIT_ALL_API=true

# Frontend
WEB_PORT=3001
BACKEND_URL=http://127.0.0.1:8194

# Tooling
JAVA_VERSION=17
MAVEN_BIN=mvn
USE_SCREEN=1

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=lineage
MYSQL_USERNAME=root
MYSQL_PASSWORD=
